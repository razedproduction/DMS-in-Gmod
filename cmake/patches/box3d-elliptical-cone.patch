+void b3SphericalJoint_SetEllipticalConeLimit( b3JointId jointId, float angleX, float angleY )
+{
+	B3_ASSERT( b3IsValidFloat( angleX ) && 0 <= angleX && angleX <= 0.5f * B3_PI );
+	B3_ASSERT( b3IsValidFloat( angleY ) && 0 <= angleY && angleY <= 0.5f * B3_PI );
+	b3JointSim* base = b3GetJointSimCheckType( jointId, b3_sphericalJoint );
+	base->sphericalJoint.coneAngle = angleX;
+	base->sphericalJoint.coneAngleY = angleY;
+}
