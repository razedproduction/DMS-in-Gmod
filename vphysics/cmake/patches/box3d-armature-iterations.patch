+// Extra Gauss-Seidel passes over the joints with armature, every graph color and the overflow, single threaded
+// between solver stages (b3World_SetArmatureIterations).
+void b3SolveArmatureJoints( b3StepContext* context, bool useBias )
+{
+	int iterations = context->world->armatureIterations;
+	b3ConstraintGraph* graph = context->graph;
+	for ( int k = 0; k < iterations; ++k )
+	{
+		for ( int c = 0; c < B3_GRAPH_COLOR_COUNT; ++c )
+		{
+			b3JointSim* joints = graph->colors[c].jointSims.data;
+			int jointCount = graph->colors[c].jointSims.count;
+			for ( int i = 0; i < jointCount; ++i )
+			{
+				if ( joints[i].armature > 0.0f )
+				{
+					b3SolveJoint( joints + i, context, useBias );
+				}
+			}
+		}
+	}
+}
