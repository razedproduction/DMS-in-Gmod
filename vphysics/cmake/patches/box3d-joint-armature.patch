+// Each armature's Cdot0 for a sub-step: the relative angular velocity the previous one ended with, taken before the
+// sub-step integrates its forces (the first sub-step's is taken by b3PrepareJoint). Once per sub-step, not per pass:
+// re-taken between passes it would undo the armature's own impulse (the one-sub-step version of this patch did that
+// inside every relax pass, unstable at more than one pass).
+void b3StoreArmatureVelocities( b3StepContext* context )
+{
+	b3ConstraintGraph* graph = context->graph;
+	for ( int c = 0; c < B3_GRAPH_COLOR_COUNT; ++c )
+	{
+		b3JointSim* joints = graph->colors[c].jointSims.data;
+		int jointCount = graph->colors[c].jointSims.count;
+		for ( int i = 0; i < jointCount; ++i )
+		{
+			b3StoreJointArmatureVelocity( joints + i, context );
+		}
+	}
+}
