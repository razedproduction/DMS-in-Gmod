+void b3Joint_SetArmature( b3JointId jointId, float armature )
+{
+	B3_ASSERT( b3IsValidFloat( armature ) && armature >= 0.0f );
+
+	b3World* world = b3GetWorld( jointId.world0 );
+	b3Joint* joint = b3GetJointFullId( world, jointId );
+	b3JointSim* base = b3GetJointSim( world, joint );
+	if ( armature <= 0.0f )
+	{
+		base->armatureImpulse = b3Vec3_zero;
+	}
+	base->armature = b3MaxFloat( armature, 0.0f );
+}
