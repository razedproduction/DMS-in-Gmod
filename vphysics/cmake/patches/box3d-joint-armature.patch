+// Joint armature
+// The armature adds kinetic energy 0.5 * a * |wB - wA|^2 to the joint. Within a sub-step it acts as a soft
+// constraint holding the relative angular velocity at its value from the start of the sub-step:
+// Cdot = wB - wA
+// J = [0 -I 0 I]
+// P = -a * (Cdot - Cdot0)  =>  (K + I / a) * P = -(Cdot - Cdot0), K = invIA + invIB
+// Cdot0 is taken when the step starts and before each later sub-step integrates its forces
+// (b3StoreArmatureVelocities), so applied torques are resisted along with the other constraints.
+static void b3PrepareJointArmature( b3JointSim* base, b3StepContext* context )
+{
+	if ( base->armature <= 0.0f )
+	{
+		base->armatureImpulse = b3Vec3_zero;
+		return;
+	}
+
+	b3World* world = context->world;
+
+	b3Body* bodyA = b3Array_Get( world->bodies, base->bodyIdA );
+	b3Body* bodyB = b3Array_Get( world->bodies, base->bodyIdB );
+
+	b3SolverSet* setA = b3Array_Get( world->solverSets, bodyA->setIndex );
+	b3SolverSet* setB = b3Array_Get( world->solverSets, bodyB->setIndex );
+
+	b3BodySim* bodySimA = b3Array_Get( setA->bodySims, bodyA->localIndex );
+	b3BodySim* bodySimB = b3Array_Get( setB->bodySims, bodyB->localIndex );
+
+	// the filter joint does not set these
+	base->invIA = bodySimA->invInertiaWorld;
+	base->invIB = bodySimB->invInertiaWorld;
+
+	base->armatureIndexA = bodyA->setIndex == b3_awakeSet ? bodyA->localIndex : B3_NULL_INDEX;
+	base->armatureIndexB = bodyB->setIndex == b3_awakeSet ? bodyB->localIndex : B3_NULL_INDEX;
+
+	float compliance = 1.0f / base->armature;
+	b3Matrix3 k = b3AddMM( base->invIA, base->invIB );
+	k.cx.x += compliance;
+	k.cy.y += compliance;
+	k.cz.z += compliance;
+	base->armatureMass = b3InvertMatrix( k );
+
+	b3Vec3 wA = base->armatureIndexA == B3_NULL_INDEX ? b3Vec3_zero : context->states[base->armatureIndexA].angularVelocity;
+	b3Vec3 wB = base->armatureIndexB == B3_NULL_INDEX ? b3Vec3_zero : context->states[base->armatureIndexB].angularVelocity;
+	base->armatureVelocity = b3Sub( wB, wA );
+
+	if ( context->enableWarmStarting == false )
+	{
+		base->armatureImpulse = b3Vec3_zero;
+	}
+}
+
+static void b3WarmStartJointArmature( b3JointSim* base, b3StepContext* context )
+{
+	if ( base->armature <= 0.0f )
+	{
+		return;
+	}
+
+	b3BodyState dummyState = b3_identityBodyState;
+	b3BodyState* stateA = base->armatureIndexA == B3_NULL_INDEX ? &dummyState : context->states + base->armatureIndexA;
+	b3BodyState* stateB = base->armatureIndexB == B3_NULL_INDEX ? &dummyState : context->states + base->armatureIndexB;
+
+	if ( stateA->flags & b3_dynamicFlag )
+	{
+		stateA->angularVelocity = b3Sub( stateA->angularVelocity, b3MulMV( base->invIA, base->armatureImpulse ) );
+	}
+
+	if ( stateB->flags & b3_dynamicFlag )
+	{
+		stateB->angularVelocity = b3Add( stateB->angularVelocity, b3MulMV( base->invIB, base->armatureImpulse ) );
+	}
+}
+
+static void b3SolveJointArmature( b3JointSim* base, b3StepContext* context )
+{
+	if ( base->armature <= 0.0f )
+	{
+		return;
+	}
+
+	b3BodyState dummyState = b3_identityBodyState;
+	b3BodyState* stateA = base->armatureIndexA == B3_NULL_INDEX ? &dummyState : context->states + base->armatureIndexA;
+	b3BodyState* stateB = base->armatureIndexB == B3_NULL_INDEX ? &dummyState : context->states + base->armatureIndexB;
+
+	b3Vec3 wA = stateA->angularVelocity;
+	b3Vec3 wB = stateB->angularVelocity;
+
+	b3Vec3 cdot = b3Sub( b3Sub( wB, wA ), base->armatureVelocity );
+	cdot = b3MulAdd( cdot, 1.0f / base->armature, base->armatureImpulse );
+	b3Vec3 impulse = b3Neg( b3MulMV( base->armatureMass, cdot ) );
+	base->armatureImpulse = b3Add( base->armatureImpulse, impulse );
+
+	if ( stateA->flags & b3_dynamicFlag )
+	{
+		stateA->angularVelocity = b3Sub( wA, b3MulMV( base->invIA, impulse ) );
+	}
+
+	if ( stateB->flags & b3_dynamicFlag )
+	{
+		stateB->angularVelocity = b3Add( wB, b3MulMV( base->invIB, impulse ) );
+	}
+}
+
+static void b3StoreJointArmatureVelocity( b3JointSim* base, b3StepContext* context )
+{
+	if ( base->armature <= 0.0f )
+	{
+		return;
+	}
+
+	b3Vec3 wA = base->armatureIndexA == B3_NULL_INDEX ? b3Vec3_zero : context->states[base->armatureIndexA].angularVelocity;
+	b3Vec3 wB = base->armatureIndexB == B3_NULL_INDEX ? b3Vec3_zero : context->states[base->armatureIndexB].angularVelocity;
+	base->armatureVelocity = b3Sub( wB, wA );
+}
