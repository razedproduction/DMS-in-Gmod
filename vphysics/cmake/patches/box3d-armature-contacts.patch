+
+// Extra Gauss-Seidel pass over the overflow contacts of bodies with armature contacts, single threaded between solver
+// stages after the armature joints (b3Body_SetArmatureContacts). Push with bias, solve without.
+void b3SolveArmatureContacts( b3StepContext* context, bool useBias )
+{
+	b3GraphColor* color = context->graph->colors + B3_OVERFLOW_INDEX;
+	b3ContactConstraint* constraints = color->contactConstraints;
+	int count = color->contacts.count;
+	for ( int i = 0; i < count; ++i )
+	{
+		if ( ( constraints[i].contact->flags & b3_simArmatureContact ) == 0 )
+		{
+			continue;
+		}
+
+		b3SolverBlock block = {
+			.startIndex = i,
+			.count = 1,
+			.blockType = b3_overflowBlock,
+			.colorIndex = B3_OVERFLOW_INDEX,
+		};
+
+		if ( useBias )
+		{
+			b3PushContacts_Mesh( block, context );
+		}
+		else
+		{
+			b3SolveContactsScalar( block, context, false );
+		}
+	}
+}
